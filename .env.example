# ----- Entorno
ENVIRONMENT=development
PORT=8001
# Orígenes que pueden usar el asistente desde el navegador, separados por coma.
# Desplegado: SOLO los dominios reales (ej. https://agro.bancocontactar.com), nunca "*".
ALLOWED_ORIGINS=http://localhost:8081

# ----- Quién pregunta
# true: exige el token de la aplicación (verificado en proyectos.url_validacion_token).
# false: SOLO en desarrollo, acepta usuario_id en el cuerpo cuando no llega token.
AUTENTICACION_REQUERIDA=true
SEGUNDOS_CACHE_TOKEN=300
# El límite diario de preguntas se reinicia a medianoche de esta zona
ZONA_HORARIA=America/Bogota

# ----- Secretos (en desarrollo aquí; desplegado, en Secrets Manager)
DATABASE_URL=postgresql+asyncpg://postgres:password_asistente@localhost:5433/bd_asistente
GEMINI_API_KEY=
# Clave para cargar documentos (/api/v1/admin). Sin ella, /admin queda cerrado.
# Genérala con: python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_API_KEY=

# ----- Modelos (el de chat se elige en asistente.configuracion_modelo; este es el respaldo)
MODELO_CHAT_RESPALDO=gemini-3.1-flash-lite
# Cambiar el modelo de embeddings o sus dimensiones obliga a recalcular todos los fragmentos
MODELO_EMBEDDING=gemini-embedding-001
EMBEDDING_DIMENSIONES=768

# ----- Búsqueda
PROYECTO_POR_DEFECTO=agro
FRAGMENTOS_POR_RESPUESTA=4
SIMILITUD_MINIMA=0.45
BONO_PANTALLA=0.05

# ----- Fichas de pantallas: conocimiento/<proyecto>/pantallas.yaml
CARPETA_CONOCIMIENTO=conocimiento

# ----- Carga de documentos
MAX_MB_DOCUMENTO=20
TAMANO_FRAGMENTO=1000
SOLAPE_FRAGMENTO=150

# ----- Almacenamiento: local (desarrollo) o s3 (desplegado)
STORAGE_TYPE=local
AWS_S3_BUCKET=
AWS_S3_REGION=us-east-1
AWS_S3_ENDPOINT=
AWS_S3_PREFIJO=asistente/
